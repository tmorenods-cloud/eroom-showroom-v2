---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "eRoom Suite — Herramientas para hoteleros y huéspedes." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/svg/eRoom-SUITE-favicon.svg" />
    <link rel="stylesheet" href="/fonts/font-face.css" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
