---
// Footer.astro — node 4034:328 en Figma. Degradado radial + wordmark gigante.
const links = [
  { label: "Términos de uso", href: "/terminos-de-uso" },
  { label: "Política de privacidad", href: "/politica-de-privacidad" },
  { label: "GDPR", href: "/gdpr" },
];
---

<footer class="footer-gradient flex flex-col gap-6 px-10 pb-6 pt-24 sm:px-[240px] sm:pt-[190px]">
  <div
    class="flex flex-col items-start justify-between gap-2 text-lg leading-[1.4] text-footer-text sm:flex-row sm:items-center"
  >
    <div class="flex flex-wrap gap-6 sm:gap-[52px]">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <p>All rights reserved © eRoom Suite 2022 - Powered by Jacidi.com</p>
  </div>

  <img
    src="/svg/eroom-suite-wordmark.svg"
    alt="eRoom Suite"
    class="mt-4 h-auto w-full max-w-[1440px]"
  />
</footer>

<style>
  .footer-gradient {
    background-image: radial-gradient(
      170.82% 103.58% at 50% 103.58%,
      var(--color-footer-1) 0%,
      var(--color-footer-2) 44.23%,
      var(--color-footer-4) 100%
    );
  }
</style>
