---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProductEditForm from "../../../components/admin/ProductEditForm";
import { getProductById } from "../../../data/products";

export const prerender = false;

const { id } = Astro.params;
const product = id ? await getProductById(id) : null;

if (!product) {
  return Astro.redirect("/admin");
}
---

<BaseLayout title={`Editar ${product.titulo} — Admin`}>
  <main class="mx-auto flex max-w-2xl flex-col gap-8 px-6 py-16">
    <a href="/admin" class="text-sm text-footer-text">← Volver al panel</a>
    <h1 class="text-2xl font-medium text-white">{product.titulo}</h1>
    <ProductEditForm client:load product={product} />
  </main>
</BaseLayout>
