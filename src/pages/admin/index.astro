---
import AdminLayout from "../../layouts/AdminLayout.astro";
import SectionTitlesForm from "../../components/admin/SectionTitlesForm";
import { getAllProducts } from "../../data/products";
import { getSectionTitles } from "../../data/settings";
import type { Categoria, Product } from "../../data/types";

export const prerender = false;

const [productos, sectionTitles] = await Promise.all([getAllProducts(), getSectionTitles()]);
const categoriaLabel: Record<Categoria, string> = {
  hotelero: "Huéspedes",
  huesped: "Hoteleros",
};
const secciones: { categoria: Categoria; productos: Product[] }[] = (
  ["hotelero", "huesped"] as Categoria[]
)
  .map((categoria) => ({ categoria, productos: productos.filter((p) => p.categoria === categoria) }))
  .filter((s) => s.productos.length > 0);
---

<AdminLayout title="Panel admin — eRoom Suite">
  <header class="sticky top-0 z-10 border-b border-admin-border bg-admin-bg/85 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-5">
      <div class="flex items-center gap-3">
        <img src="/svg/eRoom-SUITE-logotype.svg" alt="eRoom Suite" class="h-6 w-auto" />
        <span class="h-4 w-px bg-admin-border" aria-hidden="true" />
        <h1 class="text-sm font-medium text-admin-text-muted">Panel admin</h1>
      </div>
      <form method="POST" action="/api/admin/logout">
        <button
          type="submit"
          class="rounded-full border border-admin-border px-3.5 py-1.5 text-xs text-admin-text-muted transition-colors hover:border-admin-border-hover hover:text-admin-text"
        >
          Salir
        </button>
      </form>
    </div>
  </header>

  <main class="mx-auto flex max-w-6xl flex-col gap-10 px-6 py-10">
    <p class="max-w-2xl text-sm text-admin-text-muted">
      Editá título, descripción, categoría, orden, imagen, enlaces de demo y los botones de
      PDF/Video de cada tarjeta. Los cambios se ven en la web al instante, sin redeploy.
    </p>

    <SectionTitlesForm titles={sectionTitles} client:load />

    {
      secciones.map((seccion) => (
        <section class="flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <h2 class="text-xs font-medium uppercase tracking-wide text-admin-text-faint">
              {categoriaLabel[seccion.categoria]}
            </h2>
            <span class="h-px flex-1 bg-admin-border" />
            <span class="text-xs text-admin-text-faint">{seccion.productos.length}</span>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {seccion.productos.map((p) => (
              <a
                href={`/admin/productos/${p.id}`}
                class="group flex flex-col overflow-hidden rounded-admin-panel border border-admin-border bg-admin-surface transition-colors hover:border-admin-border-hover hover:bg-admin-surface-hover"
              >
                <div class="aspect-[4/3] w-full overflow-hidden bg-admin-surface-2">
                  {p.imagen ? (
                    <img
                      src={p.imagen}
                      alt={p.titulo}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center text-xs text-admin-text-faint">
                      Sin imagen
                    </div>
                  )}
                </div>

                <div class="flex flex-1 flex-col gap-3 p-4">
                  <div class="flex items-center justify-between gap-2">
                    <span class="rounded-full bg-admin-surface-2 px-2.5 py-1 text-xs font-medium text-admin-text-muted">
                      {categoriaLabel[p.categoria] ?? p.categoria}
                    </span>
                    <span class="text-xs text-admin-text-faint">#{p.orden}</span>
                  </div>

                  <p class="font-medium text-admin-text">{p.titulo}</p>

                  <div class="mt-auto flex flex-wrap gap-x-1.5 text-xs text-admin-text-faint">
                    <span>
                      {p.demos.length} demo{p.demos.length === 1 ? "" : "s"}
                    </span>
                    {p.pdfUrl && <span>· PDF</span>}
                    {p.videoUrl && <span>· Video</span>}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</AdminLayout>
