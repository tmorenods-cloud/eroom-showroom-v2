# Postgres. Local (docker-compose.yml) por defecto; en la demo de Vercel
# usá la cadena de conexión de tu proyecto de Supabase (o cualquier Postgres).
DATABASE_URL=postgres://showroom:showroom@localhost:5432/showroom

# Password único para entrar a /admin.
ADMIN_PASSWORD=cambia-esto

# Secreto para firmar la cookie de sesión del admin. Cualquier string largo
# y aleatorio — por ejemplo: openssl rand -hex 32
SESSION_SECRET=cambia-esto-tambien-por-algo-random-y-largo
